# Required — no leading spaces before variable names
BOT_TOKEN=your_telegram_bot_token

# One or more Telegram user IDs, comma-separated
ADMIN_IDS=123456789,987654321

# Public HTTPS URL of the Mini App. Telegram must be able to reach it.
MINIAPP_URL=https://your-domain/vpn/

# Port of the Mini App web server (the container publishes it on the loopback)
WEB_PORT=8080

# Optional legacy seed for card details (preferred: set in the Mini App admin → تنظیمات)
# CARD_NUMBER=6037-XXXX-XXXX-XXXX
# CARD_HOLDER=Your Name

# SQLite database path (default is fine for Docker)
DATABASE_URL=sqlite+aiosqlite:///data/db.sqlite3

# Encrypts the 3x-ui panel password and API token stored in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes the stored panel credentials unreadable.
SECRET_KEY=

# Verify TLS when connecting to the 3x-ui panel (set false only for self-signed certs in dev)
XUI_VERIFY_SSL=true

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
