# Required settings
BOT_TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789,987654321
CARD_NUMBER=6037-9971-1234-5678
CARD_HOLDER=John Doe

# Database
DATABASE_URL=sqlite+aiosqlite:///data/db.sqlite3

# --- Bot server (Germany / outside Iran) ---
# Telegram works here; panel API may return 403 from abroad.
PROVISION_MODE=remote
WORKER_SECRET=change-me-to-a-long-random-secret
WORKER_API_PORT=8080

# Optional initial panel settings (admin can also set via /panel)
XUI_PUBLIC_URL=https://your-panel.example.com:2053/your-path
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=1

# --- Worker server (Iran, same machine as 3x-ui) ---
# Run: docker compose --profile worker up -d worker
BOT_API_URL=https://your-germany-server:8080
WORKER_XUI_URL=http://127.0.0.1:2053/your-path

# Direct mode only (bot and panel on same reachable network)
# PROVISION_MODE=direct
# XUI_URL=https://your-panel.example.com:2053/your-path
